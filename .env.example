# Required. Generate with: openssl rand -hex 32
FLASK_SECRET_KEY=

# Host-side Docker listener. Keep loopback-only when using Nginx.
VTT_BIND_ADDR=127.0.0.1
VTT_PORT=8292

# Application limits and session settings.
MAX_UPLOAD_BYTES=104857600
MAX_MAPS=20
SESSION_HOURS=12
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=900
